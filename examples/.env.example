# mem0 server — example environment.  Copy to `.env` and fill in.
# Every variable the upstream server reads is listed below; commented lines are
# optional and show their default. Vars marked [image] are added by this repo's
# image (not upstream). Vars marked [script-only] are read only by the
# server/scripts maintenance commands, never by the running server.

# ─────────────────────────── Required ───────────────────────────
# LLM + embedder credentials (OpenAI is the default provider for both).
OPENAI_API_KEY=

# Auth signing secret. Required unless AUTH_DISABLED=true.
# Generate with:  openssl rand -base64 48
JWT_SECRET=

# Application database password (the postgres service below uses this too).
POSTGRES_PASSWORD=change-me

# ──────────────────── Vector store: Milvus  [image] ────────────────────
# Selects the vector store. "pgvector" (default/unset) = upstream behavior;
# "milvus" routes memory vectors to your external Milvus.
MEM0_VECTOR_STORE=milvus
# Full URL of your Milvus/Zilliz endpoint.
MILVUS_URL=http://your-milvus-host:19530
# Auth token: "user:password" (Milvus RBAC) or a Zilliz API key. Leave empty
# for an unauthenticated/local Milvus.
MILVUS_TOKEN=
# Collection mem0 stores its memories in (created automatically).
MILVUS_COLLECTION_NAME=mem0
# Must match the embedder's output dimension (text-embedding-3-small = 1536,
# text-embedding-3-large = 3072).
MILVUS_EMBEDDING_DIMS=1536
# Similarity metric: L2 | IP | COSINE.
MILVUS_METRIC_TYPE=L2
# Milvus database (namespace). Empty = the "default" database. If you set a
# name, create it first — mem0 does NOT auto-create databases, only collections.
# Lets you share one Milvus with other tools (e.g. claude-context) cleanly.
MILVUS_DB_NAME=

# ─────────────────── Application database (Postgres) ───────────────────
POSTGRES_USER=mem0
# POSTGRES_PASSWORD is set in the Required section above.
APP_DB_NAME=mem0_app
# Set by docker-compose to the postgres service; override only if running the
# server outside compose.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# Only used by the built-in pgvector store (ignored when MEM0_VECTOR_STORE=milvus),
# listed for completeness:
# POSTGRES_DB=mem0_app
# POSTGRES_COLLECTION_NAME=memories

# ─────────────────────────── Auth ───────────────────────────
# Optional legacy admin key, sent as the `X-API-Key` header. Use >= 16 chars.
# ADMIN_API_KEY=
# Disable all authentication. LOCAL DEVELOPMENT ONLY.
AUTH_DISABLED=false
# Allowed CORS origin (where the dashboard is served from).
DASHBOARD_URL=http://localhost:3000

# ─────────────────────── Default models ───────────────────────
MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# ───────────── Optional bundled providers (instead of OpenAI) ─────────────
# Only openai, anthropic, gemini (LLM) and openai, gemini (embedder) are bundled
# in the image. Set the key for whichever you switch to via the /configure API.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Custom OpenAI-compatible endpoint (proxy, Azure-style gateway, local server):
# OPENAI_BASE_URL=
# OPENAI_API_BASE=

# ─────────────────────────── Telemetry ───────────────────────────
# Anonymous; sends a single onboarding event per install. Set false to opt out.
MEM0_TELEMETRY=true
# MEM0_TELEMETRY_STATE_PATH=/app/history/telemetry.json

# ─────────────────────── History & logs ───────────────────────
# SQLite file holding mem0's change history (on the mem0_history volume).
# HISTORY_DB_PATH=/app/history/history.db
# Days of request_logs kept when `make prune-logs` runs.
# REQUEST_LOG_RETENTION_DAYS=30

# ─────────────────────────── Dashboard ───────────────────────────
# Browser-facing API URL (used by the dashboard). Change to your host/domain
# if you access the dashboard from another machine.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INSTANCE_NAME=Mem0
# API_INTERNAL_URL is set by docker-compose to http://mem0:8000.

# ──────────────── Maintenance scripts only  [script-only] ────────────────
# Consumed by server/scripts/reset_admin_password.py, e.g.:
#   docker compose exec -e EMAIL=you@example.com -e PASSWORD=new-pass mem0 \
#     python scripts/reset_admin_password.py
# EMAIL=
# PASSWORD=
